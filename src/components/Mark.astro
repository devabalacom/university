---
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---
<svg class={`mark ${className}`} viewBox="0 0 32 32" aria-hidden="true">
  <circle cx="16" cy="16" r="12" fill="none" stroke="currentColor" stroke-width="1.1" opacity=".45"/>
  <circle cx="16" cy="16" r="8.4" fill="none" stroke="currentColor" stroke-width="1.1" opacity=".7"/>
  <circle cx="16" cy="16" r="4.8" fill="none" stroke="currentColor" stroke-width="1.2"/>
  <circle cx="16" cy="16" r="1.7" fill="currentColor"/>
</svg>
