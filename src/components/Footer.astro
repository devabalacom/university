---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="in">
    <p class="footer__mark"><span>Институт</span><span>ПСАИ</span></p>

    <nav class="footer__nav" aria-label="Разделы сайта">
      <a href={`${base}/`}>Главное</a>
      <a href={`${base}/publikacii/`}>Публикации</a>
      <a href={`${base}/metod/`}>Метод</a>
      <a href={`${base}/primenenie/`}>Применение</a>
      <a href={`${base}/institut/`}>Институт</a>
    </nav>

    <div class="footer__rule"></div>
    <div class="footer__bot">
      <span>Институт предиктивной архитектуры систем</span>
      <span>© {year} PSAI</span>
    </div>
  </div>
</footer>
