---
// Single source of truth for the "Институт не является" boundary list.
// It appeared on three pages with three slightly different sets — the copy
// had drifted, so it lives here now and every page renders the same seven.
const items = [
  "консалтингом",
  "HR-инструментом",
  "системой оценки персонала",
  "типологией личности",
  "психологией",
  "коучингом",
  "эзотерической школой",
];
---
<p class="eyebrow lab">Институт не является</p>
<ul class="tags">
  {items.map((item) => <li>{item}</li>)}
</ul>
