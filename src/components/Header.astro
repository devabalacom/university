---
const base = import.meta.env.BASE_URL;
const nav = [
  { href: `${base}/institut/`, label: "Институт" },
  { href: `${base}/metod/`, label: "Метод" },
  { href: `${base}/primenenie/`, label: "Применение" },
  { href: `${base}/publikacii/`, label: "Публикации" },
];

const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === `${base}/` ? path === href : path.startsWith(href));
---
<header class="topbar">
  <div class="wrap">
    <a class="brand" href={`${base}/`} aria-current={isCurrent(`${base}/`) ? "page" : undefined}><span class="sm">PSAI</span><span class="lg">Predictive Systems Architecture Institute</span></a>
    <nav class="menu">
      {nav.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>{item.label}</a>
      ))}
    </nav>
  </div>
</header>
