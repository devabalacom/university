---
/**
 * Section nav for the long pages. Both reviewers reported the same thing:
 * on an 11 000px page there is no way to tell where you are or how much is
 * left. This sticks under the header, scrolls horizontally on a phone, and
 * highlights the section currently in view.
 */
interface Props {
  items: { id: string; label: string }[];
}
const { items } = Astro.props;
---
<nav class="secnav" aria-label="Разделы страницы">
  <div class="in">
    <ul>
      {items.map((i) => (
        <li><a href={`#${i.id}`} data-sec={i.id}>{i.label}</a></li>
      ))}
    </ul>
  </div>
</nav>

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>(".secnav a[data-sec]")];
  const targets = links
    .map((a) => ({ a, el: document.getElementById(a.dataset.sec!) }))
    .filter((t): t is { a: HTMLAnchorElement; el: HTMLElement } => Boolean(t.el));

  if (targets.length) {
    const mark = (el: Element) => {
      const hit = targets.find((t) => t.el === el);
      links.forEach((a) => a.classList.toggle("is-current", a === hit?.a));
      // keep the active chip in view when the bar itself is scrollable
      hit?.a.scrollIntoView({ block: "nearest", inline: "nearest" });
    };
    const io = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]) mark(visible[0].target);
      },
      { rootMargin: "-30% 0px -60% 0px", threshold: 0 },
    );
    targets.forEach((t) => io.observe(t.el));
  }
</script>
