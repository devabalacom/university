---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import SecNav from "../../components/SecNav.astro";
import { Image } from "astro:assets";
import strata from "../../assets/img/strata.jpg";

const base = import.meta.env.BASE_URL;
const title = "Метод — PSAI";
const description = "Компания. Рынок. Государство. Человек. Разные системы — устройство одно: девять уровней от границы до центра, девять функций на каждом, три режима у каждой.";

const levels = [
  { n: "01", nm: "Граница системы", ds: "Что является системой, а что средой; кто принадлежит; что допускается внутрь и через какие каналы", note: "Отсутствие границы и сверхжёсткая граница — одна и та же неисправность с разным знаком" },
  { n: "02", nm: "Мотивационное притяжение", ds: "Чего система хочет; чем притягивает ресурсы, людей, внимание, капитал", note: "Диффузное желание и компульсивная фиксация — оба режима отказа" },
  { n: "03", nm: "Активация движения", ds: "Способность приводить намерение в живое движение. Не намерения, а их возбуждение", note: "Апатия и хаотическое перевозбуждение лежат на одной оси" },
  { n: "04", nm: "Благоприятные условия", ds: "Культура, каналы, структуры решений, доступ к ресурсам — конфигурация, при которой движение результативно", note: "Желание есть, условий нет — самый частый источник отказа выше" },
  { n: "05", nm: "Реализация", ds: "Механизмы, которыми намерение доводится до завершённого действия", note: "Паралич исполнения и действие ради действия — оба дефицит функции" },
  { n: "06", nm: "Устойчивость", ds: "Способность выдерживать нагрузку роста, не разрушаясь от собственной экспансии", note: "Распад после роста и ригидность — противоположные проявления одного отказа" },
  { n: "07", nm: "Реинтеграция", ds: "Способность распознать и устранить собственную дисфункцию", note: "Слепота к искажениям и одержимость очищением — одна функция в двух режимах" },
  { n: "08", nm: "Интегральное согласование", ds: "Стратегия совпадает с операциями, ценности — с поведением, знание — с действием", note: "Стратегия ≠ действия — измеримая величина, а не свойство характера" },
  { n: "09", nm: "Центральная когерентность", ds: "Наличие подлинного центра, который не декларируется, а реально организует остальные уровни", note: "Потеря центра и иллюзия его достижения — оба отказ девятого уровня" },
];
---
<Base title={title} description={description}>
  <SecNav items={[
    { id: "levels", label: "Девять уровней" },
    { id: "modes", label: "Три режима" },
    { id: "functions", label: "Девять функций" },
    { id: "pair", label: "Единица анализа" },
    { id: "models", label: "Две модели" },
    { id: "procedure", label: "Процедура" },
    { id: "evidence", label: "Уровни доказательности" },
    { id: "self", label: "Метод к себе" },
  ]} />
  <main id="content">
    <section class="band band--deep" aria-labelledby="h1">
      <div class="in">
        <p class="kicker kicker--left">Метод</p>
        <h1 class="h-xl mt-3 w-56" id="h1">Компания. Рынок. Государство. Человек. Разные системы — устройство одно</h1>
        <p class="lead mt-4 w-48">Девять уровней от границы до центра. Дефицит одного уровня не устраняется усилением другого.</p>
      </div>
    </section>

    <section class="band band--grad" id="levels" aria-labelledby="h-lv">
      <div class="in">
        <div class="lv__head">
          <div>
            <h2 class="h-lg" id="h-lv">Девять уровней</h2>
            <p class="lead">Уровни идут от границы системы к её центру. Каждый следующий зависит от функции предыдущего; при её дефиците он ограничивается, становится неустойчивым либо удерживается компенсатором.</p>
          </div>
          <a class="ghost" href={`${base}/primenenie/#example`}>Как это читается на кейсе<Icon name="arrow" /></a>
        </div>

        <div class="lv__panel">
          <div class="lv__card">
            <div class="lv__cardtop">
              <p class="eyebrow-sm" id="lv-eyebrow">Уровень 01</p>
              <h3 id="lv-name">Граница системы</h3>
              <p class="desc" id="lv-desc">Что является системой, а что средой; кто принадлежит; что допускается внутрь и через какие каналы</p>
            </div>
            <a class="clink" href={`${base}/primenenie/`}>Классы расхождения<Icon name="chev" /></a>
          </div>
          <div class="lv__side">
            <span class="lv__num" id="lv-num">01</span>
            <p id="lv-note">Отсутствие границы и сверхжёсткая граница — одна и та же неисправность с разным знаком</p>
          </div>
        </div>

        <ul class="lv__list" role="tablist" aria-label="Девять уровней архитектуры">
          {levels.map((l, i) => (
            <li role="presentation">
              <button class="lv__btn" type="button" role="tab" aria-selected={i === 0 ? "true" : "false"}
                data-n={l.n} data-nm={l.nm} data-ds={l.ds} data-note={l.note}>
                <span class="lv__bar"></span>
                <span class="t" data-n={l.n}>{l.nm}</span>
              </button>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="band band--white" id="modes" aria-labelledby="h-modes">
      <div class="in">
        <p class="kicker kicker--left">Три режима</p>
        <h2 class="h-md mt-2" id="h-modes">Уровень не бывает сильным или слабым</h2>
        <p class="desc mt-3 w-48"><b>Гиперактивация — не сила.</b> Это тот же отказ уровня с обратным знаком. Отсутствие границы и сверхжёсткая граница — обе неисправность первого уровня, и обе одинаково лишают систему проницаемости.</p>
        <table class="tbl">
          <thead><tr><th>Уровень</th><th>Дефицит</th><th>Гиперактивация</th><th>Баланс</th></tr></thead>
          <tbody>
            <tr><td class="k">1 · Граница</td><td class="v" data-m="Дефицит">Границ нет</td><td class="v" data-m="Гиперактивация">Сверхжёсткость, изоляция</td><td class="v" data-m="Баланс">Управляемая проницаемость</td></tr>
            <tr><td class="k">2 · Притяжение</td><td class="v" data-m="Дефицит">Диффузное желание</td><td class="v" data-m="Гиперактивация">Компульсивная фиксация на одном</td><td class="v" data-m="Баланс">Ясная направленность при гибкости</td></tr>
            <tr><td class="k">3 · Активация</td><td class="v" data-m="Дефицит">Апатия, дисэнергия</td><td class="v" data-m="Гиперактивация">Хаотическое перевозбуждение</td><td class="v" data-m="Баланс">Управляемая интенсивность</td></tr>
            <tr><td class="k">4 · Условия</td><td class="v" data-m="Дефицит">Желание есть, условий нет</td><td class="v" data-m="Гиперактивация">Избыточное управление условиями</td><td class="v" data-m="Баланс">Умеет создавать среду</td></tr>
            <tr><td class="k">5 · Реализация</td><td class="v" data-m="Дефицит">Паралич исполнения</td><td class="v" data-m="Гиперактивация">Действие ради действия</td><td class="v" data-m="Баланс">Согласованное исполнение</td></tr>
            <tr><td class="k">6 · Устойчивость</td><td class="v" data-m="Дефицит">Распад после роста</td><td class="v" data-m="Гиперактивация">Сверхзащита, ригидность</td><td class="v" data-m="Баланс">Адаптивная устойчивость</td></tr>
            <tr><td class="k">7 · Реинтеграция</td><td class="v" data-m="Дефицит">Слепота к своим искажениям</td><td class="v" data-m="Гиперактивация">Одержимость очищением</td><td class="v" data-m="Баланс">Зрелая самокоррекция</td></tr>
            <tr><td class="k">8 · Согласование</td><td class="v" data-m="Дефицит">Стратегия ≠ действия</td><td class="v" data-m="Гиперактивация">Иллюзия абсолютного знания</td><td class="v" data-m="Баланс">Глубокое согласование</td></tr>
            <tr><td class="k">9 · Центр</td><td class="v" data-m="Дефицит">Потеря центра</td><td class="v" data-m="Гиперактивация">Иллюзия достижения центра</td><td class="v" data-m="Баланс">Подлинная целостность</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="band band--deep" id="functions" aria-labelledby="h-fn">
      <div class="in">
        <div class="oneup">
          <div class="oneup__col">
            <p class="kicker kicker--left">Девять функций</p>
            <h2 class="h-md" id="h-fn">Уровень — это где. Функция — это что</h2>
            <p class="desc">Уровень задаёт топологическую позицию от границы к центру. Функция задаёт способность. Пересечение даёт 81 точку описания: как каждая способность проявляется на каждой позиции.</p>
          </div>
          <div class="oneup__mediawrap">
            <ul class="cls">
              <li><span class="n">01</span><span><b>Смысловая ориентация</b></span></li>
              <li><span class="n">02</span><span><b>Граничная определённость</b></span></li>
              <li><span class="n">03</span><span><b>Структурная организация</b></span></li>
              <li><span class="n">04</span><span><b>Процессная связность</b></span></li>
              <li><span class="n">05</span><span><b>Ресурсное обеспечение</b></span></li>
              <li><span class="n">06</span><span><b>Управленческая регуляция</b></span></li>
              <li><span class="n">07</span><span><b>Коммуникационная передача</b></span></li>
              <li><span class="n">08</span><span><b>Адаптация и обратная связь</b></span></li>
              <li><span class="n">09</span><span><b>Развитие и масштабирование</b></span></li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="band band--blue" id="pair" aria-labelledby="h-pair">
      <div class="in">
        <p class="kicker">Единица анализа</p>
        <p class="dek mt-3" id="h-pair">Отдельно взятая система не бывает ни эффективной, ни неэффективной</p>
        <p class="lead measure-c mt-4">Эффективность появляется только относительно того, с чем система соприкасается. Единица анализа — пара: компания ↔ рынок, департамент ↔ компания, человек ↔ роль. Обе стороны описываются одним стандартом.</p>
        <p class="note centered mt-3">Одна и та же компания на домашнем рынке — в балансе, на зарубежном — в дефиците. В компании ничего не изменилось. Изменилось требование второй стороны.</p>
      </div>
    </section>

    <section class="band band--white" id="models" aria-labelledby="h-models">
      <div class="in">
        <p class="kicker kicker--left">Две модели</p>
        <h2 class="h-md mt-2" id="h-models">Два вопроса, на которые отвечает описание</h2>
        <table class="tbl">
          <thead><tr><th>Модель</th><th>Что описывает</th><th>Отвечает</th></tr></thead>
          <tbody>
            <tr><td class="n">9 × 9</td><td class="k">Архитектура системы</td><td class="v" data-m="Отвечает"><b>Где</b> расхождение</td></tr>
            <tr><td class="n">7 × 5</td><td class="k">Регуляционная архитектура человека</td><td class="v" data-m="Отвечает"><b>Что требуется от носителя</b> и выдерживает ли это кто-нибудь</td></tr>
          </tbody>
        </table>
        <p class="desc mt-4 w-48"><b>Сравнивать можно только соизмеримое.</b> Пока компанию описывают через выручку и оргструктуру, а рынок — через объём и конкурентов, расхождение между ними обсуждают. Когда обе стороны сведены к одному стандарту, расхождение становится величиной.</p>
      </div>
    </section>

    <section class="band band--grey" id="procedure" aria-labelledby="h-phase">
      <div class="in">
        <p class="kicker kicker--left">Процедура</p>
        <h2 class="h-md mt-2 w-52" id="h-phase">Пропуск фазы — это переход, происхождение которого нельзя восстановить и проверить</h2>
        <table class="tbl">
          <tbody>
            <tr><td class="n">1</td><td class="k">Паспорт</td><td class="v" data-m="Содержание">Что за пара · ради какой функции существует связка · цель исследования</td></tr>
            <tr><td class="n">2</td><td class="k">Диагностика</td><td class="v" data-m="Содержание">Обе стороны описаны стандартом. Только наблюдаемое</td></tr>
            <tr><td class="n">3</td><td class="k">Архитектура</td><td class="v" data-m="Содержание">Где расхождение · что оно требует от роли · кто носитель</td></tr>
            <tr><td class="n">4</td><td class="k">Вывод</td><td class="v" data-m="Содержание">Девять полей стандарта AOS-001</td></tr>
          </tbody>
        </table>
        <p class="desc mt-4 w-48"><b>Паспорт первым — не формальность.</b> Без зафиксированной цели расхождение не отличить от различия, и любой факт можно объявить проблемой. <b>Продукт до диагностики не существует:</b> рекомендация, выданная раньше архитектуры, — это мнение, оформленное как результат.</p>
      </div>
    </section>

    <section class="band band--deep" id="evidence" aria-labelledby="h-ev">
      <div class="in">
        <p class="kicker kicker--left">Уровни доказательности</p>
        <h2 class="h-md mt-2" id="h-ev">Вывод несёт на себе степень собственной проверенности</h2>
        <table class="tbl">
          <thead><tr><th>Уровень</th><th>Название</th><th>Основание</th></tr></thead>
          <tbody>
            <tr><td class="n">I</td><td class="k">Исследовательская гипотеза</td><td class="v" data-m="Основание">Следует из модели. Не проверена</td></tr>
            <tr><td class="n">II</td><td class="k">Подтверждённая гипотеза</td><td class="v" data-m="Основание">Несколько независимых источников</td></tr>
            <tr><td class="n">III</td><td class="k">Воспроизводимая закономерность</td><td class="v" data-m="Основание">Подтверждается кейсами. Повторяема</td></tr>
            <tr><td class="n">IV</td><td class="k">Архитектурный принцип</td><td class="v" data-m="Основание">Подтверждён многократно. Внесён в стандарт</td></tr>
          </tbody>
        </table>
        <p class="desc mt-4 w-52"><b>Каждый вывод несёт девять полей:</b> локус · факт · интерпретация · механизм · эффект при изменении условий · уровень доказательности · что опровергнет · горизонт обратимости · свободная энергия.</p>
        <p class="note mt-2 w-52">Факт отделён от интерпретации физически, а не стилистически. В поле факта не бывает слов «слабый», «недостаточный», «плохо». Вывод без поля «что опровергнет» выводом не является.</p>
        <p class="mt-4"><a class="ghost" href={`${base}/primenenie/#example`}>Все девять полей на живом выводе<Icon name="arrow" /></a></p>
      </div>
    </section>

    <section class="band band--white" id="self" aria-labelledby="h-self">
      <div class="in">
        <div class="oneup">
          <div class="oneup__col">
            <p class="kicker kicker--left">Метод к себе</p>
            <h2 class="h-md" id="h-self">Метод применяется к себе прежде, чем к объекту</h2>
            <p class="desc">Стандарты Института проходят собственные уровни доказательности. Расхождения между внутренними канонами обнаруживаются той же процедурой, что и у объекта исследования, — и версионируются с датой, источником и обоснованием. Метод, не выдержавший применения к автору, не предъявляется.</p>
            <a class="btn2" href={`${base}/institut/#kanon`}>Версии канона<Icon name="arrow" /></a>
          </div>
          <figure class="oneup__plate">
            <Image src={strata} alt="Слои, нанизанные на общую вертикальную ось и опирающиеся на нижнюю границу" widths={[384, 768]} sizes="(max-width: 767px) 80vw, 22rem" />
            <figcaption>Девять уровней как слои на общей оси: каждый опирается на нижний</figcaption>
          </figure>
        </div>
      </div>
    </section>
  </main>
</Base>

<script>
  const btns = document.querySelectorAll<HTMLButtonElement>(".lv__btn");
  const set = (id: string, text: string) => {
    const el = document.getElementById(id);
    if (el) el.textContent = text;
  };
  btns.forEach((b) => {
    b.addEventListener("click", () => {
      btns.forEach((o) => o.setAttribute("aria-selected", String(o === b)));
      set("lv-eyebrow", `Уровень ${b.dataset.n}`);
      set("lv-name", b.dataset.nm ?? "");
      set("lv-desc", b.dataset.ds ?? "");
      set("lv-num", b.dataset.n ?? "");
      set("lv-note", b.dataset.note ?? "");
    });
  });
</script>
