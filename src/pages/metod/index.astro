<script>
  /* The level selector itself needs no script: it is a radio group, and the
     stylesheet shows the card and the detail panel of the checked level.
     This only opens the panel's disclosure when its «Раскрыть» link is used,
     which a fragment link cannot do on its own. */
  document.querySelectorAll<HTMLAnchorElement>(".detail-link").forEach((a) => {
    a.addEventListener("click", () => {
      const id = a.getAttribute("href")?.slice(1);
      const d = id ? document.getElementById(id)?.querySelector("details") : null;
      if (d) d.open = true;
    });
  });
</script>
