---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { Image } from "astro:assets";
import rings from "../assets/img/rings.jpg";
import strata from "../assets/img/strata.jpg";
import network from "../assets/img/network.jpg";

const base = import.meta.env.BASE_URL;
const title = "Институт предиктивной архитектуры систем — PSAI";
const description = "Части работоспособны, система нерезультативна. Институт исследует согласованность систем: девять уровней архитектуры, четыре класса расхождения, вывод с уровнем доказательности и фальсификатором.";

const levels = [
  { n: "01", nm: "Граница системы", ds: "Что является системой, а что средой; кто принадлежит; что допускается внутрь и через какие каналы", note: "Уровень в дефиците не отказывает сразу — он перекладывает свою функцию на соседний" },
  { n: "02", nm: "Мотивационное притяжение", ds: "Чего система хочет; чем притягивает ресурсы, людей, внимание, капитал", note: "Усиление мотивации не устраняет отказ, если мотивационная функция уже обеспечена" },
  { n: "03", nm: "Активация движения", ds: "Способность приводить намерение в живое движение. Не намерения, а их возбуждение", note: "Между «хочет» и «делает» лежит отдельная функция, и она отказывает отдельно" },
  { n: "04", nm: "Благоприятные условия", ds: "Культура, каналы, структуры решений, доступ к ресурсам — конфигурация, при которой движение результативно", note: "Отказ проявляется на уровне реализации, а находится здесь" },
  { n: "05", nm: "Реализация", ds: "Механизмы, которыми намерение доводится до завершённого действия", note: "Исполнители есть, инструменты внедрены, регламенты написаны — и результата нет" },
  { n: "06", nm: "Устойчивость", ds: "Способность выдерживать нагрузку роста, не разрушаясь от собственной экспансии", note: "Рост разрушает компенсатор, который держал систему до роста" },
  { n: "07", nm: "Реинтеграция", ds: "Способность распознать и устранить собственную дисфункцию", note: "Система, не видящая своих искажений, не может их исправить" },
  { n: "08", nm: "Интегральное согласование", ds: "Стратегия совпадает с операциями, ценности — с поведением, знание — с действием", note: "Расхождение между сказанным и сделанным — измеримая величина, а не характер" },
  { n: "09", nm: "Центральная когерентность", ds: "Наличие подлинного центра, который не декларируется, а реально организует остальные уровни", note: "Центр, который приходится объявлять, центром не является" },
];
---
<Base title={title} description={description}>
  <section class="bento" aria-label="Главное">
    <div class="bento__grid">
      <div class="b-intro">
        <p class="b-kicker">Институт предиктивной архитектуры систем · исследование согласованности функциональных систем</p>
        <h1 class="b-title"><span>Где теряется</span><span>согласованность?</span></h1>
        <p class="b-desc">Части работоспособны. Система нерезультативна. Противоречия здесь нет: результативность держится на согласованности уровней, а не на исправности частей.</p>
        <div class="b-cta">
          <a class="ghost" href="#content">Как это устроено<Icon name="arrow" /></a>
        </div>
      </div>

      <a class="b-card b-featured" href={`${base}/metod/`}>
        <span class="b-card__bg"><Image src={rings} alt="" widths={[720, 1080, 1376]} sizes="(max-width: 760px) 100vw, 46vw" /></span>
        <div class="b-card__content">
          <div>
            <span class="b-eyebrow">Метод</span>
            <h2>Девять уровней архитектуры системы</h2>
          </div>
          <span class="btn">Читать метод<Icon name="arrow" /></span>
        </div>
      </a>

      <a class="b-card b-item2" href={`${base}/publikacii/granicy-predskazuemosti/`}>
        <span class="b-card__bg"><Image src={network} alt="" widths={[480, 720, 1184]} sizes="(max-width: 760px) 100vw, 26vw" /></span>
        <div class="b-card__content">
          <div>
            <span class="b-eyebrow">Публикация</span>
            <h3>Границы предсказуемости: что метод может и чего не может<Icon name="chev" /></h3>
          </div>
        </div>
      </a>

      <a class="b-card b-item3" href={`${base}/primenenie/#example`}>
        <div class="b-card__content">
          <div>
            <span class="b-eyebrow">Разбор кейса · класс 1</span>
            <h3>Условия держатся на носителях, а не на структуре<Icon name="chev" /></h3>
          </div>
        </div>
      </a>

      <a class="b-card b-item4" href={`${base}/institut/`}>
        <span class="b-card__bg"><Image src={strata} alt="" widths={[384, 640, 768]} sizes="(max-width: 760px) 100vw, 26vw" /></span>
        <div class="b-card__content">
          <div>
            <span class="b-eyebrow">Институт</span>
            <h3>Что исследует Институт<Icon name="chev" /></h3>
          </div>
        </div>
      </a>

      <a class="b-card b-item5" href={`${base}/primenenie/`}>
        <div class="b-card__content">
          <div>
            <span class="b-eyebrow">Применение</span>
            <h3>Четыре класса расхождения<Icon name="chev" /></h3>
          </div>
        </div>
      </a>

      <div class="b-card b-promo">
        <div class="b-card__content">
          <span class="b-eyebrow">Что производит Институт</span>
          <ul>
            <li>Стандарты — правила описания систем и правила вывода</li>
            <li>Библиотеки — паттерны, ограничения, компенсаторы</li>
            <li>Исследования — применение стандарта к конкретным системам</li>
            <li>Публикации — результаты, доступные проверке</li>
          </ul>
          <a class="clink" href={`${base}/institut/`}>Об институте<Icon name="chev" /></a>
        </div>
      </div>
    </div>
  </section>

  <main id="content">
    <!-- ══ институт ══ -->
    <section class="band band--deep tu" aria-labelledby="h-inst">
      <div class="tu__strip">
        <div class="tu__bg" style={`background-image:url('${base}/img/network.jpg')`}></div>
        <div class="in tu__inner">
          <div class="tu__col">
            <p class="kicker kicker--left">Институт</p>
            <h2 class="h-md" id="h-inst">Прогноз структуры, а не событий</h2>
            <p class="desc">PSAI прогнозирует не события, а изменение вероятностной структуры системы. Чем сложнее система, тем менее предсказуемо отдельное событие — и тем отчётливее её структурная тенденция.</p>
            <a class="ghost" href="#content">Как это устроено<Icon name="arrow" /></a>
          </div>
        </div>
      </div>
    </section>

    <!-- ══ девять уровней ══ -->
    <section class="band band--deep" aria-labelledby="h-lv">
      <div class="in">
        <div class="lv__head">
          <div>
            <h2 class="h-lg" id="h-lv">Девять уровней</h2>
            <p class="lead">Компания. Рынок. Государство. Человек. Разные системы, устройство одно. Каждый уровень отвечает за одну функцию и обеспечивает следующий.</p>
          </div>
          <a class="ghost" href={`${base}/publikacii/granicy-predskazuemosti/`}>Границы метода<Icon name="arrow" /></a>
        </div>

        <div class="lv__panel">
          <div class="lv__card">
            <div class="lv__cardtop">
              <p class="eyebrow-sm" id="lv-eyebrow">Уровень 01</p>
              <h3 id="lv-name">Граница системы</h3>
              <p class="desc" id="lv-desc">Что является системой, а что средой; кто принадлежит; что допускается внутрь и через какие каналы</p>
            </div>
            <a class="clink" href={`${base}/metod/`}>Как читается расхождение<Icon name="chev" /></a>
          </div>
          <div class="lv__side">
            <span class="lv__num" id="lv-num">01</span>
            <p id="lv-note">Уровень в дефиците не отказывает сразу — он перекладывает свою функцию на соседний</p>
          </div>
        </div>

        <ul class="lv__list" role="tablist" aria-label="Девять уровней архитектуры">
          {levels.map((l, i) => (
            <li role="presentation">
              <button
                class="lv__btn"
                type="button"
                role="tab"
                aria-selected={i === 0 ? "true" : "false"}
                data-n={l.n}
                data-nm={l.nm}
                data-ds={l.ds}
                data-note={l.note}>
                <span class="lv__bar"></span>
                <span class="t" data-n={l.n}>{l.nm}</span>
              </button>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ══ когда это нужно ══ -->
    <section class="band band--deep" aria-labelledby="h-when">
      <div class="in up">
        <div class="up__head">
          <p class="kicker">Когда обращаются</p>
          <p class="dek" id="h-when">Три ситуации, в которых причина не находится ни в одном элементе</p>
        </div>
        <div class="up__grid">
          <div class="up__item up__item--rule">
            <div class="up__body">
              <p class="ih">Усиление не даёт результата</p>
              <p class="desc">Стратегия верна, люди компетентны, процессы описаны — а результата нет. Ресурс вкладывается в уровень, который и так в балансе.</p>
            </div>
          </div>
          <div class="up__item up__item--rule">
            <div class="up__body">
              <p class="ih">Роль не закрывается</p>
              <p class="desc">Кандидаты подходят по квалификации и не удерживаются в роли. Разрыв лежит между системой и ролью, а не в носителе.</p>
            </div>
          </div>
          <div class="up__item up__item--rule">
            <div class="up__body">
              <p class="ih">Смена среды ломает то, что работало</p>
              <p class="desc">Компания в балансе на домашнем рынке уходит в дефицит на зарубежном. Внутри ничего не изменилось — изменилось требование второй стороны.</p>
            </div>
          </div>
        </div>
        <p class="mt-5"><a class="ghost" href={`${base}/primenenie/`}>Четыре класса расхождения<Icon name="arrow" /></a></p>
      </div>
    </section>

    <!-- ══ применение ══ -->
    <section class="band band--white" aria-labelledby="h-app">
      <div class="in">
        <p class="kicker">Применение</p>
        <div class="oneup">
          <div class="oneup__col">
            <h2 class="h-md" id="h-app">Четыре класса расхождения</h2>
            <p class="desc">Расхождение возникает там, где требование должно быть обеспечено либо где два архитектурных описания должны быть согласованы.</p>
            <a class="btn2" href={`${base}/primenenie/#example`}>Смотреть разбор кейса<Icon name="arrow" /></a>
          </div>
          <div class="oneup__mediawrap">
            <ul class="cls">
              <li><span class="n">Класс 1</span><span><b>Между уровнями</b><span class="d">Уровень не обеспечивает следующий или пережимает его</span></span></li>
              <li><span class="n">Класс 2</span><span><b>Между системами</b><span class="d">Способность одной не совпадает с требованием второй</span></span></li>
              <li><span class="n">Класс 3</span><span><b>Система и роль</b><span class="d">Вынесенная функция обеспечена не так, как требует</span></span></li>
              <li><span class="n">Класс 4</span><span><b>Роль и носитель</b><span class="d">Регуляция носителя не совпадает с требованием роли</span></span></li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ══ разбор кейса ══ -->
    <section class="band band--blue" aria-labelledby="h-case">
      <div class="in up">
        <div class="up__head">
          <p class="kicker">Разбор кейса</p>
          <p class="dek" id="h-case">Три вывода, полученные по стандарту</p>
          <p class="note centered">Пример построен на типовой конфигурации. Числовые значения иллюстративны.</p>
        </div>
        <div class="vd">
          <div class="vd__item">
            <span class="vd__id">Вывод В-01 · класс 1</span>
            <h3>Условия результативности удерживаются носителями, а не структурой</h3>
            <p>Уровень 4 в дефицитном режиме: условия не заданы структурой, их функцию исполняет неформальная сеть носителей контекста. Компенсатор опирается на плотность связей, а не на численность, и рост эту плотность разрушает.</p>
            <span class="vd__lvl">II — подтверждённая гипотеза</span>
          </div>
          <div class="vd__item">
            <span class="vd__id">Вывод В-02 · класс 3</span>
            <h3>Роль вынесена наружу. Обеспечение осталось внутри</h3>
            <p>Роль вынесена, чтобы создать условия. Создание условий требует доступа к критериям решений, а критерии находятся не в документах, а в носителях, которые роли не подчинены.</p>
            <span class="vd__lvl">II — подтверждённая гипотеза</span>
          </div>
          <div class="vd__item">
            <span class="vd__id">Вывод В-03 · класс 4</span>
            <h3>Требование роли к носителю внутренне противоречиво</h3>
            <p>Роль требует одновременно принадлежать контуру носителей — иначе контекст не передадут — и обесценить этот контур, формализовав то, что составляет основание его положения.</p>
            <span class="vd__lvl">I — исследовательская гипотеза</span>
          </div>
        </div>
        <p class="mt-5"><a class="ghost" href={`${base}/primenenie/#example`}>Разбор целиком<Icon name="arrow" /></a></p>
      </div>
    </section>

    <!-- ══ границы ══ -->
    <section class="band band--grey" aria-labelledby="h-bounds">
      <div class="in">
        <h2 class="h-md mb-5" id="h-bounds">Границы</h2>
        <div class="acc">
          <div class="acc__item is-open">
            <h3>
              <button class="acc__btn" type="button" aria-expanded="true" aria-controls="acc1">
                Что Институт утверждает<Icon name="chev-down" />
              </button>
            </h3>
            <div class="acc__body" id="acc1">
              <p>Расхождение между двумя системами измеримо и существует до того, как проявится. Точечный прогноз запрещён физически, структурный — не запрещён. Управление уже опирается на модель, и вопрос лишь в том, явная она или нет, проверяема или нет, известно ли, что её опровергнет.</p>
            </div>
          </div>
          <div class="acc__item">
            <h3>
              <button class="acc__btn" type="button" aria-expanded="false" aria-controls="acc2">
                Чего Институт не утверждает<Icon name="chev-down" />
              </button>
            </h3>
            <div class="acc__body" id="acc2">
              <p>Что результат гарантирован. Что мониторинг архитектуры устраняет неопределённость. Что верная модель делает управление успешным — теорема этого не говорит, и Институт не будет говорить за неё.</p>
            </div>
          </div>
          <div class="acc__item">
            <h3>
              <button class="acc__btn" type="button" aria-expanded="false" aria-controls="acc3">
                Чем Институт не является<Icon name="chev-down" />
              </button>
            </h3>
            <div class="acc__body" id="acc3">
              <ul>
                <li>Консалтингом</li>
                <li>HR-инструментом</li>
                <li>Системой оценки персонала</li>
                <li>Типологией личности</li>
                <li>Психологией</li>
                <li>Коучингом</li>
                <li>Эзотерической школой</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</Base>

<script>
  // levels selector — the card and the number panel follow the chosen level
  const btns = document.querySelectorAll<HTMLButtonElement>(".lv__btn");
  const set = (id: string, text: string) => {
    const el = document.getElementById(id);
    if (el) el.textContent = text;
  };
  btns.forEach((b) => {
    b.addEventListener("click", () => {
      btns.forEach((o) => o.setAttribute("aria-selected", String(o === b)));
      set("lv-eyebrow", `Уровень ${b.dataset.n}`);
      set("lv-name", b.dataset.nm ?? "");
      set("lv-desc", b.dataset.ds ?? "");
      set("lv-num", b.dataset.n ?? "");
      set("lv-note", b.dataset.note ?? "");
    });
  });

  // accordion
  document.querySelectorAll<HTMLButtonElement>(".acc__btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const item = btn.closest(".acc__item");
      const open = btn.getAttribute("aria-expanded") === "true";
      btn.setAttribute("aria-expanded", String(!open));
      item?.classList.toggle("is-open", !open);
    });
  });
</script>
