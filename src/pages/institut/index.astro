---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import { Image } from "astro:assets";
import network from "../../assets/img/network.jpg";
import rings from "../../assets/img/rings.jpg";

const base = import.meta.env.BASE_URL;
const title = "Институт — PSAI";
const description = "Институт существует, чтобы вывод о системе перестал быть мнением. Объект исследования — согласованность функциональных систем.";
---
<Base title={title} description={description}>
  <main id="content">
    <section class="band band--deep" aria-labelledby="h1">
      <div class="in">
        <p class="kicker kicker--left">Институт</p>
        <h1 class="h-xl mt-3 w-60" id="h1">Институт существует, чтобы вывод о системе перестал быть мнением</h1>
        <p class="lead mt-4 w-48">Объект исследования — согласованность функциональных систем. Люди, организации, рынки и государства рассматриваются не изолированно, а как системы, реализующие функции и вступающие в отношения с другими системами.</p>
      </div>
    </section>

    <section class="band band--white" aria-labelledby="h-what">
      <div class="in">
        <div class="oneup">
          <div class="oneup__col">
            <p class="kicker kicker--left">Объект и предмет</p>
            <h2 class="h-md" id="h-what">Почему одни системы сохраняют способность к реализации функций, а другие её утрачивают</h2>
            <p class="desc">Теория связывает эту способность с согласованностью структуры, процессов, среды и направления движения.</p>
            <a class="btn2" href={`${base}/metod/`}>Метод<Icon name="arrow" /></a>
          </div>
          <div class="oneup__mediawrap">
            <ul class="cls">
              <li><span class="n">Объект</span><span><b>Согласованность функциональных систем</b><span class="d">Системы, реализующие функции и вступающие в отношения с другими системами</span></span></li>
              <li><span class="n">Предмет</span><span><b>Условия устойчивой реализации функции</b><span class="d">Возникновение архитектурных расхождений, их компенсация и проявление</span></span></li>
              <li><span class="n">Единица</span><span><b>Расхождение</b><span class="d">Между требованием и фактическим обеспечением либо между независимыми описаниями одной связи</span></span></li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="band band--deep tu" aria-labelledby="h-cond">
      <div class="tu__strip">
        <div class="tu__bg" style={`background-image:url('${base}/img/network.jpg')`}></div>
        <div class="in tu__inner">
          <div class="tu__col">
            <p class="kicker kicker--left">Условие согласованности</p>
            <h2 class="h-md" id="h-cond">Согласованность поддерживается функционально достаточной регуляцией, а не максимальной</h2>
            <p class="desc">Обратная связь должна быть достаточной, но не тотальной: когда показатель становится целью, он перестаёт быть показателем. Контроль, полностью подчиняющий себе функцию, создаёт риск бюрократического замещения; отсутствие контроля повышает риск потери управляемости.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="band band--grad" aria-labelledby="h-prod">
      <div class="in up">
        <div class="up__head">
          <p class="kicker">Что Институт производит</p>
          <p class="dek" id="h-prod">Знание с обозначенным уровнем доказательности</p>
        </div>
        <div class="up__grid">
          <div class="up__item up__item--rule">
            <div class="up__body">
              <p class="ih">Стандарты</p>
              <p class="desc">Правила описания систем, правила вывода, требования к исследовательской процедуре.</p>
            </div>
          </div>
          <div class="up__item up__item--rule">
            <div class="up__body">
              <p class="ih">Библиотеки</p>
              <p class="desc">Проверенные архитектурные паттерны, ограничения, компенсаторы, классы расхождения.</p>
            </div>
          </div>
          <div class="up__item up__item--rule">
            <div class="up__body">
              <p class="ih">Исследования</p>
              <p class="desc">Применение стандарта к конкретным системам. Каждое исследование должно произвести проверяемое архитектурное описание.</p>
            </div>
          </div>
        </div>
        <p class="note mt-5 w-52">Единичный случай может дать наблюдение, описание конфигурации или исследовательскую гипотезу, но не является достаточным основанием для включения закономерности в стандарт.</p>
      </div>
    </section>

    <section class="band band--white" id="kanon" aria-labelledby="h-kanon">
      <div class="in">
        <p class="kicker kicker--left">Версии канона</p>
        <h2 class="h-md mt-2 w-48" id="h-kanon">Канон — это то, что Институт считает установленным на сегодня. Он версионируется, потому что может измениться</h2>
        <p class="desc mt-3 w-48">Каждый действующий стандарт проходит те же уровни доказательности, которые применяются к объекту исследования. Изменение канона фиксируется датой, источником и обоснованием — иначе изменить его нельзя.</p>
        <table class="tbl">
          <thead><tr><th>Обозначение</th><th>Канон</th><th>Состояние</th></tr></thead>
          <tbody>
            <tr><td class="n">AOS-001</td><td class="k">Стандарт архитектурного вывода</td><td class="v" data-m="Состояние">Девять полей вывода, четыре уровня доказательности. Действующая редакция</td></tr>
            <tr><td class="n">9 × 9</td><td class="k">Архитектура системы</td><td class="v" data-m="Состояние">Девять уровней, девять функций. Действующая редакция</td></tr>
            <tr><td class="n">7 × 5</td><td class="k">Регуляционная архитектура человека</td><td class="v" data-m="Состояние">Семь доменов регуляции, пять слоёв проявления. Действующая редакция</td></tr>
            <tr><td class="n">Классы</td><td class="k">Классы расхождения</td><td class="v" data-m="Состояние">Четыре базовых класса. Открыт к расширению при подтверждённых основаниях</td></tr>
          </tbody>
        </table>
        <p class="note mt-3">Перечень отражает состав действующего канона. Полные редакции с датами и обоснованием изменений публикуются по мере вынесения за пределы Института.</p>
        <p class="mt-4"><a class="btn2" href={`${base}/metod/`}>Правила вывода<Icon name="arrow" /></a></p>
      </div>
    </section>

    <section class="band band--grey" aria-labelledby="h-bounds">
      <div class="in">
        <h2 class="h-md mb-5" id="h-bounds">Границы</h2>
        <div class="acc">
          <div class="acc__item is-open">
            <h3><button class="acc__btn" type="button" aria-expanded="true" aria-controls="a1">Границы предсказуемости<Icon name="chev-down" /></button></h3>
            <div class="acc__body" id="a1">
              <p>PSAI не предсказывает отдельное событие в сложной системе. Институт исследует структурную тенденцию: условия сохранения функции, конфигурацию расхождений, устойчивость компенсаторов и диапазон вероятных изменений.</p>
              <p><a class="clink" href={`${base}/publikacii/granicy-predskazuemosti/`}>Публикация целиком<Icon name="chev" /></a></p>
            </div>
          </div>
          <div class="acc__item">
            <h3><button class="acc__btn" type="button" aria-expanded="false" aria-controls="a2">Что допускается внутрь<Icon name="chev-down" /></button></h3>
            <div class="acc__body" id="a2">
              <p>Внутрь допускается то, что имеет обозначенное основание и уровень доказательности. Не допускаются: единичный случай как подтверждённая закономерность, утверждение без источника и вывод без указания на то, что его может опровергнуть.</p>
            </div>
          </div>
          <div class="acc__item">
            <h3><button class="acc__btn" type="button" aria-expanded="false" aria-controls="a3">Чем Институт не является<Icon name="chev-down" /></button></h3>
            <div class="acc__body" id="a3">
              <ul>
                <li>Консалтингом</li><li>HR-инструментом</li><li>Системой оценки персонала</li>
                <li>Типологией личности</li><li>Психологией</li><li>Коучингом</li><li>Эзотерической школой</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="band band--deep" aria-label="Дальше">
      <div class="in up">
        <div class="up__grid">
          <a class="up__item up__item--half" href={`${base}/metod/`}>
            <span class="up__media"><Image src={rings} alt="Кольца, сходящиеся к общему центру" widths={[480, 720]} sizes="(max-width: 767px) 90vw, 45vw" /></span>
            <span class="up__body"><span class="ih">Метод<Icon name="chev" /></span><span class="desc">Девять уровней, три режима, две модели и стандарт вывода.</span></span>
          </a>
          <a class="up__item up__item--half" href={`${base}/primenenie/`}>
            <span class="up__media"><Image src={network} alt="Узлы, сходящиеся к точке согласования" widths={[480, 720]} sizes="(max-width: 767px) 90vw, 45vw" /></span>
            <span class="up__body"><span class="ih">Применение<Icon name="chev" /></span><span class="desc">Четыре класса расхождения и разбор кейса целиком.</span></span>
          </a>
        </div>
      </div>
    </section>
  </main>
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>(".acc__btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const item = btn.closest(".acc__item");
      const open = btn.getAttribute("aria-expanded") === "true";
      btn.setAttribute("aria-expanded", String(!open));
      item?.classList.toggle("is-open", !open);
    });
  });
</script>
