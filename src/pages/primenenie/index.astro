---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import SecNav from "../../components/SecNav.astro";

const base = import.meta.env.BASE_URL;
const title = "Применение — PSAI";
const description = "Четыре класса расхождения и полный разбор кейса: девять полей вывода, уровень доказательности и фальсификатор у каждого.";

const classes = [
  { n: "Класс 1", t: "Между уровнями одной системы", claim: "Отказ часто становится заметен не на том уровне, где возникает.",
    body: "Каждый нижний уровень обеспечивает функцию следующего и ограничивает диапазон его возможного. Ресурс вкладывается в наблюдаемое проявление: усиливается уровень, который может находиться в балансе, тогда как источник дефицита остаётся нетронутым.",
    modes: [["Дефицит","Уровень не даёт следующему опоры. Верхний предъявляет требование, нижний его не обеспечивает"],
            ["Гипер","Уровень пережимает следующий. Верхний блокирован не отсутствием опоры, а её жёсткостью"],
            ["Баланс","Уровень обеспечивает следующий и ограничивает его соразмерно"]] },
  { n: "Класс 2", t: "Между двумя системами", claim: "Согласованность принадлежит отношению, а не одной из сторон.",
    body: "Расхождение между двумя системами не обнаруживается ни в одной из них. Аудит любой стороны по отдельности его не найдёт — не потому, что проведён плохо, а потому, что искомого нет ни в одной: оно в паре. Смена второй стороны превращает баланс в дефицит без единого изменения внутри системы.",
    modes: [["Дефицит","Способность системы ниже требования второй стороны"],
            ["Гипер","Способность избыточна относительно требования. Избыток не бесплатен — он оплачивается темпом, ресурсом и гибкостью"],
            ["Баланс","Способность и требование соразмерны"]] },
  { n: "Класс 3", t: "Между системой и ролью", claim: "Роль неисполнима одинаково — когда система не даёт опоры и когда не даёт действовать.",
    body: "Роль есть функция, вынесенная системой наружу. Вынести функцию мало — её нужно обеспечить уровнями, которые дают структуру решений, ресурс и полномочия. Отдельный случай — дефицит с обеих сторон: функция не исполняется вообще, и это не проявляется как жалоба, потому что никто не перегружен.",
    modes: [["Дефицит","Роль вынесена, обеспечение — нет. Разрыв ложится на регуляцию носителя"],
            ["Гипер","Роль зарегулирована. Носитель не может вмешаться, даже будучи полностью способным"],
            ["Баланс","Обеспечение соразмерно требованию роли"]] },
  { n: "Класс 4", t: "Между ролью и носителем", claim: "Соответствие роли не может быть определено одной квалификацией.",
    body: "Квалификация — это архив: она фиксирует, что человек делал в другой системе, в другой среде, в другое время. Насколько то взаимодействие было согласованным, квалификация не сообщает. Режим определяется отклонением от функционального оптимума для этой роли, а не силой показателя.",
    modes: [["Дефицит","Регуляция носителя ниже требования роли"],
            ["Гипер","Регуляция выше требования. Носитель ломает роль, обходит её или уходит"],
            ["Баланс","Регуляция соразмерна требованию роли"]] },
];
---
<Base title={title} description={description}>
  <SecNav items={[
    { id: "classes", label: "Четыре класса" },
    { id: "c0", label: "Класс 1" },
    { id: "c1", label: "Класс 2" },
    { id: "c2", label: "Класс 3" },
    { id: "c3", label: "Класс 4" },
    { id: "example", label: "Разбор кейса" },
    { id: "v1", label: "В-01" },
    { id: "v2", label: "В-02" },
    { id: "v3", label: "В-03" },
    { id: "outcome", label: "Что получает организация" },
    { id: "refuse", label: "Когда откажет" },
  ]} />
  <main id="content">
    <section class="band band--deep" aria-labelledby="h1">
      <div class="in">
        <p class="kicker kicker--left">Применение</p>
        <h1 class="h-xl mt-3 w-56" id="h1">Исследование делает наблюдаемым то, что система производит</h1>
        <p class="lead mt-4 w-48">Самоописание не является независимым наблюдением: описывающая позиция сама входит в предмет исследования. Производимый эффект определяется конкретной связью и потому исследуется относительно второй стороны.</p>
      </div>
    </section>

    <section class="band band--white" id="classes" aria-labelledby="h-cls">
      <div class="in">
        <p class="kicker kicker--left">Четыре класса</p>
        <div class="oneup">
          <div class="oneup__col">
            <h2 class="h-md" id="h-cls">Расхождение возникает там, где требование должно быть обеспечено</h2>
            <p class="desc">Либо где два архитектурных описания должны быть согласованы. В текущем каноне метода выделены четыре базовых класса. Каждый существует в трёх режимах: дефицит, гиперактивация, баланс.</p>
            <a class="btn2" href="#example">Смотреть разбор кейса<Icon name="arrow" /></a>
          </div>
          <div class="oneup__mediawrap">
            <ul class="cls">
              <li><span class="n">Класс 1</span><span><b>Между уровнями</b><span class="d">Уровень не обеспечивает следующий или пережимает его</span></span></li>
              <li><span class="n">Класс 2</span><span><b>Между системами</b><span class="d">Способность одной не совпадает с требованием второй</span></span></li>
              <li><span class="n">Класс 3</span><span><b>Система и роль</b><span class="d">Вынесенная функция обеспечена не так, как требует</span></span></li>
              <li><span class="n">Класс 4</span><span><b>Роль и носитель</b><span class="d">Регуляция носителя не совпадает с требованием роли</span></span></li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    {classes.map((c, i) => (
      <section class={`band ${i % 2 === 0 ? "band--grey" : "band--white"}`} id={`c${i}`} aria-labelledby={`h-c${i}`}>
        <div class="in">
          <p class="kicker kicker--left">{c.n} · {c.t}</p>
          <h2 class="h-md mt-2 w-52" id={`h-c${i}`}>{c.claim}</h2>
          <p class="desc mt-3 w-48">{c.body}</p>
          <table class="tbl">
            <thead><tr><th>Режим</th><th>Что это значит</th></tr></thead>
            <tbody>
              {c.modes.map(([m, d]) => (
                <tr><td class="k">{m}</td><td class="v" data-m={m}>{d}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    ))}

    <section class="band band--blue" aria-labelledby="h-fb">
      <div class="in">
        <p class="dek" id="h-fb">Существует оптимальная плотность обратной связи</p>
        <p class="lead measure-c mt-3">Слишком слабая — система разваливается. Слишком сильная — колеблется. Слишком частая — становится нервной. Слишком редкая — теряет управление.</p>
      </div>
    </section>

    <!-- ══ разбор кейса ══ -->
    <section class="band band--deep" id="example" aria-labelledby="h-ex">
      <div class="in">
        <p class="kicker kicker--left">Разбор кейса</p>
        <h2 class="h-md mt-2" id="h-ex">Задача клиента: нужен операционный директор, чтобы разгрузить собственника</h2>
        <p class="note mt-2">Пример построен на типовой конфигурации. Числовые значения иллюстративны.</p>
        <p class="note mt-1">Ниже — три вывода из этого исследования, приведённые сокращённо. Полный вывод по стандарту AOS-001 несёт девять полей; у каждого сокращения ниже указано, какие поля опущены.</p>

        <table class="tbl">
          <thead><tr><th>Шаг</th><th>Фаза</th><th>Содержание</th></tr></thead>
          <tbody>
            <tr><td class="n">1</td><td class="k">Паспорт</td><td class="v" data-m="Содержание">Зафиксирована пара, функция связки, цель исследования</td></tr>
            <tr><td class="n">2</td><td class="k">Архитектура компании</td><td class="v" data-m="Содержание">Девять уровней, на каждом девять функций. 81 точка, режим каждой</td></tr>
            <tr><td class="n">3</td><td class="k">Архитектура рынка</td><td class="v" data-m="Содержание">Вторая сторона описана тем же стандартом. Рынок — система: у него те же девять уровней</td></tr>
            <tr><td class="n">4</td><td class="k">Сопоставление</td><td class="v" data-m="Содержание">Где требование одной стороны не совпадает со способностью второй</td></tr>
            <tr><td class="n">5</td><td class="k">Локализация роли</td><td class="v" data-m="Содержание">Какая функция вынесена наружу и чем обеспечена изнутри</td></tr>
            <tr><td class="n">6</td><td class="k">Регуляционная архитектура</td><td class="v" data-m="Содержание">Профиль требования роли к носителю: 35 точек, режим каждой</td></tr>
            <tr><td class="n">7</td><td class="k">Выводы</td><td class="v" data-m="Содержание">Девять полей на каждый. Уровень доказательности и фальсификатор — обязательны</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="band band--white" id="v1" aria-labelledby="h-v1">
      <div class="in w-56">
        <p class="kicker kicker--left">Вывод В-01 · класс 1</p>
        <h2 class="h-md mt-2" id="h-v1">Условия результативности удерживаются носителями, а не структурой</h2>
        <div class="fields">
          <div class="fields__row"><span class="fields__n">Локус</span><p>Архитектура системы · уровень 4 Архитектура благоприятных условий · функция 4 Процессная связность</p></div>
          <div class="fields__row"><span class="fields__n">Факт</span>
            <p>Медиана времени от постановки задачи до первого действия выросла в 4,1 раза за период, в котором штат вырос в 2,6 раза. Доля задач, потребовавших обращения к сотрудникам со стажем свыше пяти лет — 68%. Критерии приоритизации не документированы ни в одном регламенте. Число санкционированных исключений из регламента за квартал — 47 при 31 действующем регламенте.</p>
            <p class="src">Источники: выгрузка таск-трекера за 8 кварталов · 11 интервью на трёх уровнях иерархии · реестр регламентов и служебных записок об исключениях</p></div>
          <div class="fields__row"><span class="fields__n">Интерпретация</span><p>Уровень 4 в дефицитном режиме: условия результативности не заданы структурой. Функцию условий исполняет неформальная сеть носителей контекста. Уровень 5 при этом в балансе — исполнители есть, инструменты внедрены, регламенты написаны. Отказ проявляется на уровне реализации, а находится на уровне условий.</p></div>
          <div class="fields__row"><span class="fields__n">Механизм</span>
            <p>Ограничение — критерии решений не существуют вне голов носителей. Компенсатор — институциональная память старожилов, работавшая при малом штате: контекст передавался прямым контактом, издержки доступа были близки к нулю.</p>
            <p>Компенсатор опирается на плотность связей, а не на численность. При росте штата число необходимых связей растёт квадратично, пропускная способность носителя не растёт вообще. Ограничение не устранялось ни разу — оно удерживалось плотностью, и рост эту плотность разрушает.</p></div>
          <div class="fields__row"><span class="fields__n">Эффект при изменении условий</span><p>Точка отказа наступает, когда время доступа к носителю контекста превышает время выполнения самой задачи. После неё найм ухудшает результат: новый сотрудник добавляет очередь к носителю раньше, чем начинает производить. Наблюдаемо это выглядит как падение отдачи от найма при исправной воронке и исправном онбординге.</p></div>
          <div class="fields__row"><span class="fields__n">Уровень доказательности</span><p><b>II — подтверждённая гипотеза</b></p><p class="src">Три независимых источника. Квадратичный характер роста нагрузки на кейсах данной компании не измерялся.</p></div>
          <div class="fields__row"><span class="fields__n">Что опровергнет</span><p>Обнаружение документированных критериев приоритизации, применяемых сотрудниками со стажем менее года без обращения к носителям. Либо период роста штата, в котором время до первого действия не росло.</p></div>
          <div class="fields__row"><span class="fields__n">Горизонт обратимости</span><p>До следующей волны найма. Каждая волна увеличивает объём неформального контекста, подлежащего извлечению, и удорожает извлечение нелинейно.</p></div>
          <div class="fields__row"><span class="fields__n">Свободная энергия</span><p>Время носителей контекста, расходуемое сейчас на восстановление критериев в каждом обращении.</p></div>
        </div>
      </div>
    </section>

    <section class="band band--grey" id="v2" aria-labelledby="h-v2">
      <div class="in w-56">
        <p class="kicker kicker--left">Вывод В-02 · класс 3</p>
        <h2 class="h-md mt-2" id="h-v2">Роль вынесена наружу. Обеспечение осталось внутри</h2>
        <div class="fields">
          <div class="fields__row"><span class="fields__n">Локус</span><p>Стык системы и роли · роль «операционный директор»</p></div>
          <div class="fields__row"><span class="fields__n">Механизм</span>
            <p>Роль вынесена, чтобы создать условия. Создание условий требует доступа к критериям решений — а критерии находятся не в документах, а в носителях, которые роли не подчинены.</p>
            <p>Обеспечение осталось внутри системы и с требованием роли не совпало. Разрыв не исчезает: он переходит на регуляцию того, кто роль займёт. Чего не обеспечила система, обеспечивает носитель — своим ресурсом.</p></div>
          <div class="fields__row"><span class="fields__n">Эффект при изменении условий</span><p>Роль будет закрыта формально при любом найме. Ограничение В-01 при этом сохраняется: операционный директор не имеет полномочий над источником критериев.</p></div>
          <div class="fields__row"><span class="fields__n">Уровень доказательности</span><p><b>II — подтверждённая гипотеза</b></p><p class="src">Следует из В-01, подтверждается организационной схемой и интервью.</p></div>
          <div class="fields__row"><span class="fields__n">Что опровергнет</span><p>Прецедент, где роль без полномочий над носителями изменила документированные критерии решений.</p></div>
          <div class="fields__row"><span class="fields__n">Горизонт обратимости</span><p>До определения полномочий роли.</p></div>
        </div>
        <p class="abridged"><b>Сокращено.</b> <span>Опущены поля «факт», «интерпретация» и «свободная энергия»: в этом выводе они опираются на те же источники, что и В-01, и в сокращённом изложении не приводятся.</span></p>
      </div>
    </section>

    <section class="band band--white" id="v3" aria-labelledby="h-v3">
      <div class="in w-56">
        <p class="kicker kicker--left">Вывод В-03 · класс 4</p>
        <h2 class="h-md mt-2" id="h-v3">Требование роли к носителю внутренне противоречиво</h2>
        <div class="fields">
          <div class="fields__row"><span class="fields__n">Локус</span><p>Регуляционная архитектура человека · требование роли «операционный директор»</p></div>
          <div class="fields__row"><span class="fields__n">Метод</span><p>Из тридцати пяти точек для этой роли значимы пять. Профиль строится как требование роли, а не как оценка кандидата: режим определяется отклонением от оптимума для этой конкретной роли.</p></div>
          <div class="fields__row"><span class="fields__n">Профиль требования</span>
            <table class="tbl mt-1">
              <tbody>
                <tr><td class="n">A4</td><td class="v" data-m="Требование">Достроить структуру решений там, где её не существует. <b>Требование: выше среднего.</b> Дефицит — не сможет формализовать неявное</td></tr>
                <tr><td class="n">B3</td><td class="v" data-m="Требование">Извлечь знание у тех, кто не обязан его отдавать. <b>Требование: баланс.</b> Гипер — давление, носители закрываются</td></tr>
                <tr><td class="n">C5</td><td class="v" data-m="Требование">Принадлежность к контуру носителей. <b>Требование: выше среднего.</b> Контекст передают только своему</td></tr>
                <tr><td class="n">D5</td><td class="v" data-m="Требование">Влияние без формальных полномочий. <b>Требование: баланс.</b> Дефицит — не сдвинет. Гипер — конфликт с носителями</td></tr>
                <tr><td class="n">F2</td><td class="v" data-m="Требование">Выносливость под длительным сопротивлением без видимого результата. <b>Требование: выше среднего</b></td></tr>
              </tbody>
            </table></div>
          <div class="fields__row"><span class="fields__n">Механизм</span>
            <p>Противоречие локализовано в точке C5. Роль требует одновременно принадлежать контуру носителей — иначе контекст не передадут — и обесценить этот контур, формализовав то, что составляет основание его положения.</p>
            <p>Внешний носитель не проходит по C5: доступа к контексту не получит. Внутренний проходит по C5 и не может исполнить A4: формализация обесценивает его собственную позицию, за удержание которой система его и вознаграждала. Это не вопрос лояльности, а конфликт требований внутри одной роли.</p></div>
          <div class="fields__row"><span class="fields__n">Эффект</span><p>Любой найм даёт один из исходов: роль исполняется формально при сохранении компенсатора, носитель выгорает, закрывая разрыв своим ресурсом, либо уходит. Профиль не спасает, потому что противоречие не в носителе, а в конструкции роли.</p></div>
          <div class="fields__row"><span class="fields__n">Уровень доказательности</span><p><b>I — исследовательская гипотеза</b></p><p class="src">Следует из архитектуры В-01 и В-02. Кейсами не проверена.</p></div>
          <div class="fields__row"><span class="fields__n">Что опровергнет</span><p>Случай, где носитель контекста формализовал собственную функцию и сохранил позицию. Либо внешний руководитель, получивший доступ к неформальным критериям в срок до двух кварталов.</p></div>
          <div class="fields__row"><span class="fields__n">Горизонт обратимости</span><p>До публикации вакансии.</p></div>
        </div>
        <p class="abridged"><b>Сокращено.</b> <span>Поля «факт» и «интерпретация» заменены полями «метод» и «профиль требования»: вывод класса 4 строится на регуляционной модели 7 × 5, и стандарт допускает эту замену для профиля роли.</span></p>
      </div>
    </section>

    <section class="band band--blue" aria-labelledby="h-res">
      <div class="in">
        <p class="dek" id="h-res">Клиент пришёл за операционным директором</p>
        <p class="lead measure-c mt-3">Архитектурная потребность — извлечь и формализовать критерии решений до найма. Роль, созданная раньше этого, неисполнима независимо от того, кто её займёт.</p>
      </div>
    </section>

    <section class="band band--deep" id="outcome" aria-labelledby="h-out">
      <div class="in up">
        <div class="up__head">
          <p class="kicker">Что получает организация</p>
          <p class="dek" id="h-out">Шесть результатов, каждый проверяемый</p>
        </div>
        <div class="up__grid">
          <div class="up__item up__item--rule"><div class="up__body"><p class="ih">Карта расхождений</p><p class="desc">В каком классе и где именно.</p></div></div>
          <div class="up__item up__item--rule"><div class="up__body"><p class="ih">Перечень выводов</p><p class="desc">Каждый с локусом, механизмом и уровнем доказательности.</p></div></div>
          <div class="up__item up__item--rule"><div class="up__body"><p class="ih">Горизонты обратимости</p><p class="desc">До какого решения каждая ошибка ещё дёшева.</p></div></div>
          <div class="up__item up__item--rule"><div class="up__body"><p class="ih">Архитектурная потребность</p><p class="desc">Что нужно системе — против того, что было заказано.</p></div></div>
          <div class="up__item up__item--rule"><div class="up__body"><p class="ih">Свободная энергия</p><p class="desc">Что высвободится при снятии ограничения.</p></div></div>
          <div class="up__item up__item--rule"><div class="up__body"><p class="ih">Фальсификаторы</p><p class="desc">Что опровергнет каждый вывод.</p></div></div>
        </div>
      </div>
    </section>

    <section class="band band--grey" id="refuse" aria-labelledby="h-no">
      <div class="in">
        <h2 class="h-md mb-5" id="h-no">Когда Институт откажет</h2>
        <div class="acc">
          <div class="acc__item is-open">
            <h3><button class="acc__btn" type="button" aria-expanded="true" aria-controls="n1">Основания для отказа<Icon name="chev-down" /></button></h3>
            <div class="acc__body" id="n1">
              <p>Если задача требует вывода без основания. Если запрошена рекомендация без диагностики. Если объект исследования не определён. Если единственный доступный источник — слова заказчика.</p>
              <p>Отказ формулируется как архитектурное основание. Целостность метода выше отдельного заказа.</p>
            </div>
          </div>
          <div class="acc__item">
            <h3><button class="acc__btn" type="button" aria-expanded="false" aria-controls="n2">Что не входит в вывод<Icon name="chev-down" /></button></h3>
            <div class="acc__body" id="n2">
              <ul>
                <li>Единичный случай как знание</li><li>Слова заказчика как архитектурная потребность</li>
                <li>Продукт до диагностики</li><li>Утверждение без источника</li>
                <li>Уверенность эксперта как основание</li><li>Отраслевое среднее как критерий</li>
              </ul>
            </div>
          </div>
          <div class="acc__item">
            <h3><button class="acc__btn" type="button" aria-expanded="false" aria-controls="n3">Чем Институт не является<Icon name="chev-down" /></button></h3>
            <div class="acc__body" id="n3">
              <ul>
                <li>Консалтингом</li><li>HR-инструментом</li><li>Системой оценки персонала</li>
                <li>Типологией личности</li><li>Психологией</li><li>Коучингом</li><li>Эзотерической школой</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>(".acc__btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const item = btn.closest(".acc__item");
      const open = btn.getAttribute("aria-expanded") === "true";
      btn.setAttribute("aria-expanded", String(!open));
      item?.classList.toggle("is-open", !open);
    });
  });
</script>
