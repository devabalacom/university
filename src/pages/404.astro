---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const title = "Страница не найдена — PSAI";
const description = "Запрошенной страницы не существует. Разделы Института: Институт, Метод, Применение, Публикации.";
---
<Base title={title} description={description}>
  <main id="content">
    <section class="band band--deep" aria-labelledby="h1">
      <div class="in">
        <p class="kicker kicker--left">Ошибка 404</p>
        <h1 class="h-xl mt-3" id="h1">Такой страницы нет</h1>
        <p class="lead mt-4 w-44">Адрес указывает на страницу, которой не существует, либо она была перемещена. Ниже разделы, которые существуют.</p>
      </div>
    </section>

    <section class="band band--white" aria-labelledby="h-nav">
      <div class="in">
        <h2 class="h-md" id="h-nav">Разделы</h2>
        <ul class="publist">
          <li><a class="pubitem" href={`${base}/`}><span class="pubitem__body"><h3>Главная</h3><span class="desc">Где теряется согласованность.</span></span><span class="pubitem__go" aria-hidden="true"><Icon name="arrow" /></span></a></li>
          <li><a class="pubitem" href={`${base}/institut/`}><span class="pubitem__body"><h3>Институт</h3><span class="desc">Объект, предмет, что производит и версии канона.</span></span><span class="pubitem__go" aria-hidden="true"><Icon name="arrow" /></span></a></li>
          <li><a class="pubitem" href={`${base}/metod/`}><span class="pubitem__body"><h3>Метод</h3><span class="desc">Девять уровней, три режима, две модели, стандарт вывода.</span></span><span class="pubitem__go" aria-hidden="true"><Icon name="arrow" /></span></a></li>
          <li><a class="pubitem" href={`${base}/primenenie/`}><span class="pubitem__body"><h3>Применение</h3><span class="desc">Четыре класса расхождения и разбор кейса.</span></span><span class="pubitem__go" aria-hidden="true"><Icon name="arrow" /></span></a></li>
          <li><a class="pubitem" href={`${base}/publikacii/`}><span class="pubitem__body"><h3>Публикации</h3><span class="desc">Результаты, вынесенные за пределы Института.</span></span><span class="pubitem__go" aria-hidden="true"><Icon name="arrow" /></span></a></li>
        </ul>
      </div>
    </section>
  </main>
</Base>
