---
import Base from "../../layouts/Base.astro";

const title = "Публикации · Институт предиктивной архитектуры систем";
const description = "Результаты, вынесенные за пределы Института и доступные независимому прочтению, проверке и критике.";

const publications = [
  {
    slug: "granitsy-predskazuemosti",
    kicker: "Публикация 01 · Теоретическая",
    title: "Границы предсказуемости",
    lede: "Что метод может и чего не может. Почему точечный прогноз сложной системы ограничен, а структурная тенденция остаётся предметом исследования.",
  },
];
---
<Base title={title} description={description}>
  <section class="pagehead">
    <div class="wrap">
      <span class="eyebrow" style="color:var(--gold);display:block;margin-bottom:1.25rem">Публикации</span>
      <h1>Результаты, вынесенные за пределы Института и доступные проверке.</h1>
      <p class="sub">Каждая публикация указывает основание своих положений, уровень доказательности и границы применимости.</p>
    </div>
  </section>

  <main class="wrap">
    <section class="reveal">
      <div class="pub-grid">
        {publications.map((pub) => (
          <a class="pub-card" href={`/publikacii/${pub.slug}/`}>
            <span class="pub-kicker">{pub.kicker}</span>
            <h2>{pub.title}</h2>
            <p>{pub.lede}</p>
            <span class="go">Читать →</span>
          </a>
        ))}
      </div>
    </section>
  </main>
</Base>

<style>
  .pub-grid{display:grid;gap:1.5rem}
  .pub-card{
    display:block;border:1px solid var(--hair);border-radius:var(--radius);
    padding:1.75rem 1.5rem;text-decoration:none;background:var(--bg-raised);
    box-shadow:var(--shadow-card);transition:transform .18s cubic-bezier(.16,1,.3,1),border-color .18s;
  }
  .pub-card:hover{transform:translateY(-2px);border-color:var(--gold)}
  .pub-kicker{font-family:var(--mono);font-size:.62rem;font-weight:500;letter-spacing:.12em;text-transform:uppercase;color:var(--golddark);display:block;margin-bottom:.75rem}
  .pub-card h2{font-size:1.35rem;margin-bottom:.6rem}
  .pub-card p{margin:0 0 1.25rem;font-size:.9375rem;line-height:1.6;color:var(--text-dim);max-width:36rem}
  @media (min-width:52rem){
    .pub-card{padding:2.5rem 2.25rem}
  }
</style>
