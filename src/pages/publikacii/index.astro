---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import { groups, inGroup } from "../../data/publications";

const base = import.meta.env.BASE_URL;
const title = "Публикации — PSAI";
const description = "Аналитические статьи и научные обзоры. Каждое утверждение снабжено источником и уровнем доказательности.";
---
<Base title={title} description={description}>
  {/* The draft opens this page on paper, not on a navy hero: an eyebrow, the
      title, a standfirst and a rule — then straight into the groups. */}
  <main id="content">
    <section class="band band--white" aria-label="Публикации">
      <div class="in in--reading">
        <div class="phead">
          <p class="kicker kicker--left">Публикации</p>
          <h1 class="phead__title" id="h1">Исследования Института</h1>
          <p class="phead__sub">Аналитические статьи и научные обзоры. Каждое утверждение снабжено источником и уровнем доказательности.</p>
        </div>

        {groups.map((group, gi) => (
          <div class={gi === 0 ? "pubgroup" : "pubgroup mt-6"}>
            <h2 class="pubgroup__name">{group}</h2>
            <ul class="publist">
              {inGroup(group).map((pub) => (
                <li>
                  <a class="pubitem" href={`${base}/publikacii/${pub.slug}/`}>
                    <span class="pubitem__body">
                      <span class="eyebrow-sm">Публикация {pub.no}</span>
                      <h3>{pub.title}</h3>
                      <span class="desc">{pub.lede}</span>
                    </span>
                    <span class="pubitem__go">Читать<Icon name="arrow" /></span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
        <p class="note mt-6">Следующая публикация выходит по мере вынесения результата за пределы Института. Расписания нет.</p>
      </div>
    </section>
  </main>
</Base>
