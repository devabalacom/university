---
import Base from "../../layouts/Base.astro";
import { publications } from "../../data/publications";

const base = import.meta.env.BASE_URL;
const title = "Публикации — PSAI";
const description = "Институт публикует результаты, вынесенные за его пределы и доступные независимому прочтению, проверке и критике.";
---
<Base title={title} description={description}>
  <section class="splash">
    <div class="body">
      <div class="wrap">
        <span class="eyebrow lab">Публикации</span>
        <h1>Результат становится знанием только тогда, когда вынесен за пределы Института и <em>доступен проверке</em>.</h1>
        <p class="sub">Каждая публикация указывает основание своих положений, уровень доказательности и границы применимости.</p>
        <p class="sub2">Публикации выходят по мере вынесения результатов за пределы Института — не по расписанию.</p>
      </div>
    </div>
    <button class="cue" type="button" data-to="content">Перечень публикаций ↓</button>
  </section>

  <main class="wrap" id="content">
    <section>
      <h2>Перечень.</h2>
      <ul class="publist">
        {publications.map((pub) => (
          <li>
            <a class="pubitem" href={`${base}/publikacii/${pub.slug}/`}>
              <span class="pubmeta">
                <span>Публикация {pub.no}</span>
                <span class="sep" aria-hidden="true">·</span>
                <span class="kind">{pub.kind}</span>
              </span>
              <h3>{pub.title}</h3>
              <p class="lede">{pub.lede}</p>
              <span class="more">Читать →</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section>
      <h2>Что обязана содержать публикация.</h2>
      <p class="beat">Публикация — это вывод, вынесенный наружу вместе с тем, что позволяет его оспорить.</p>
      <table class="t2">
        <tbody>
          <tr><td class="k">Основание</td><td class="v">Источник каждого положения. Утверждение без источника публикации не подлежит</td></tr>
          <tr><td class="k">Уровень доказательности</td><td class="v">От I — исследовательской гипотезы — до IV, архитектурного принципа, внесённого в стандарт</td></tr>
          <tr><td class="k">Границы применимости</td><td class="v">К каким системам и при каких условиях вывод относится, а к каким не относится</td></tr>
          <tr><td class="k">Фальсификатор</td><td class="v">Что именно опровергнет вывод. Утверждение, которое нечем опровергнуть, — это мнение</td></tr>
        </tbody>
      </table>
      <a class="go" href={`${base}/metod/`}>Правила вывода →</a><a class="go" href={`${base}/institut/#kanon`}>Версии канона →</a>
    </section>
  </main>
</Base>
