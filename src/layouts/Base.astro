---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Set on article pages so social cards report the right type. */
  ogType?: "website" | "article";
}

const { title, description, ogType = "website" } = Astro.props;
const site = Astro.site ?? new URL("https://devabalacom.github.io");
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, site).toString();
const ogImage = new URL(`${base}/og.jpg`, site).toString();
const siteName = "Институт предиктивной архитектуры систем";
---
<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>

<link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml">
<meta name="theme-color" content="#051C2C">


<link rel="preload" href={`${base}/fonts/PSAI-Display-normal-400_600-83c9b620.woff2`} as="font" type="font/woff2" crossorigin>

<meta property="og:type" content={ogType}>
<meta property="og:locale" content="ru_RU">
<meta property="og:site_name" content={siteName}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={ogImage}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={siteName}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImage}>
</head>
<body>
<a class="skip" href="#content">К содержанию</a>
<Header />
<slot />
<Footer />
</body>
</html>
